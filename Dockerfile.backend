# syntax=docker/dockerfile:1.7

# 固定 uv 版本：仅用于复制 uv/uvx 二进制，保证依赖解析行为可复现。
FROM ghcr.io/astral-sh/uv:0.12.23 AS uv

# 固定 Python 3.12 slim 运行时；uv.lock 的 requires-python 为 ==3.12.*。
FROM python:3.12-slim-bookworm AS runtime

# 包索引：uv.lock 已按 TUNA 镜像源锁定，--frozen 直接使用锁文件中的下载地址。
# 直连 files.pythonhosted.org 在本网络下被限速到约 118KB/s 且会 tls handshake eof，
# 58MiB 的 opencv-python-headless 反复重试仍失败（一次构建耗 23 分钟）。
# 该参数只在重新解析依赖时生效；换回官方源须同时重新锁定：
#   uv lock --default-index https://pypi.org/simple
ARG UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_PYTHON_DOWNLOADS=never \
    HOME=/tmp \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    M_PHOTO_DATA_DIR=/data \
    GEO_AI_MODE=mock

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

# 先复制锁文件与 pyproject 引用的 readme，最大化依赖层缓存；
# --no-dev 只安装运行依赖，pytest 等开发依赖不进入镜像。
COPY pyproject.toml uv.lock ./
COPY backend/README.md ./backend/README.md
# uv 下载缓存挂在 BuildKit 缓存卷上：约 200MiB 的 wheel 只在首次构建下载，
# 后续重试或改代码重建无需重下，缓存本身也不写入镜像层。
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv sync --frozen --no-dev --no-install-project

# 新 FastAPI 后端及其根目录依赖模块；旧 Flask 代码不进入镜像。
# .dockerignore 已排除 backend/.venv、backend/tests、storage/uploads、数据库等非运行文件。
# 包含 Alembic 配置/迁移脚本；由应用 lifespan 在运行时升级挂载的数据库。
COPY backend/ ./backend/
COPY services/ ./services/
COPY catalog_db.py ./
COPY config.py ./
COPY data/ ./data/
COPY scripts/ocr_download_models.py ./scripts/ocr_download_models.py

# 使用数值 UID 的非 root 运行身份，避免依赖 passwd 工具或额外 apt 安装。
RUN mkdir -p /data /tmp/uv-cache \
    && chown -R 10001:10001 /data /app /opt/venv /tmp/uv-cache

USER 10001:10001

EXPOSE 8000

# 生产启动命令；uv run --no-sync 使用已安装的锁定依赖，不再联网同步。
CMD ["uv", "run", "--frozen", "--no-sync", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
