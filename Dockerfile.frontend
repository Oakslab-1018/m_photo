# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=24

# ---------- 构建阶段：npm ci + Vite 生产构建 ----------
FROM node:${NODE_VERSION}-bookworm-slim AS build

WORKDIR /app

# 地图样式：public client-side 配置，不是服务端密钥。MapTiler key 必须在
# MapTiler 控制台配置来源/Referrer 限制；两参数为空时回落到随包发布的
# Esri World Imagery 样式。
ARG VITE_MAP_STYLE_URL=
ARG VITE_MAPTILER_API_KEY=
ENV VITE_MAP_STYLE_URL=${VITE_MAP_STYLE_URL} \
    VITE_MAPTILER_API_KEY=${VITE_MAPTILER_API_KEY}

# package-lock.json 必须由前端 worker 提交，npm ci 依赖它保证可复现构建。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ---------- 运行阶段：Nginx 只托管 dist，不使用 Vite 生产服务器 ----------
FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80