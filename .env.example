# Copy to .env; never commit real credentials. Frontend remains loopback-only.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Off by default for fresh installs. Enable after scripts/setup-streetclip.ps1.
STREETCLIP_ENABLED=false
# Docker backend -> host model service; native backend should use 127.0.0.1.
STREETCLIP_URL=http://host.docker.internal:8001
# Same bearer token is loaded by the native model service and the backend.
STREETCLIP_API_KEY=
STREETCLIP_TIMEOUT_SECONDS=45
STREETCLIP_DEVICE=cuda
# Blank DeepSeek key disables remote narration; no GPU is used locally for it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15
