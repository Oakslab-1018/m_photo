# Copy to .env; never commit real credentials. Frontend remains loopback-only.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# OCR: mock (offline) or rapidocr (PP-OCRv5 det/cls/rec on ONNX Runtime, CPU).
# OCR_MODEL_TYPE=server is the accuracy-oriented default; mobile remains a
# lower-latency compatibility profile. Precache with:
#   powershell -File scripts/setup-ocr.ps1 -ModelType server
# Models are cached under M_PHOTO_DATA_DIR/ocr-models (Docker: /data/ocr-models).
OCR_PROVIDER=rapidocr
OCR_MODEL_TYPE=server
# Explicit PP-OCRv5 .onnx paths override the cached defaults (optional).
# Provenance reports only their basenames, never local paths.
# OCR_DET_MODEL_PATH=
# OCR_REC_MODEL_PATH=
# OCR_CLS_MODEL_PATH=
# Line score floor before a text line is accepted, and minimum OCR-line
# confidence before a language clue is emitted (both 0..1).
OCR_MIN_TEXT_SCORE=0.5
OCR_LANGUAGE_MIN_CONFIDENCE=0.7

# Off by default for fresh installs. Enable after scripts/setup-streetclip.ps1.
STREETCLIP_ENABLED=false
# Docker backend -> host model service; native backend should use 127.0.0.1.
STREETCLIP_URL=http://host.docker.internal:8001
# Same bearer token is loaded by the native model service and the backend.
STREETCLIP_API_KEY=
STREETCLIP_TIMEOUT_SECONDS=45
STREETCLIP_DEVICE=cuda
# Optional SQLite geo catalog seed for the native StreetCLIP service.
# Defaults to <repo>/data/geo_catalog.sqlite3; JSON catalogs are not read.
# STREETCLIP_CATALOG_DB=
# Cities per country ranked by /predict-cities; the backend caps and validates
# whatever the service returns, and the UI only shows a handful.
STREETCLIP_CITY_LIMIT_PER_COUNTRY=100
# Optional labeled street-view index. Unset (default) means no reference
# retrieval: /predict simply omits the `reference` sidecar, and the backend
# omits the diagnostic fields instead of reporting empty matches.
# STREETCLIP_REFERENCE_INDEX=
# Blank DeepSeek key disables remote narration; no GPU is used locally for it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15

# CPU stays available; cuda uses the independent local GPU OCR service.
OCR_DEVICE=cpu
OCR_GPU_URL=http://host.docker.internal:8003
OCR_GPU_TIMEOUT_SECONDS=60
OCR_CPU_INTRA_OP_THREADS=4
OCR_CPU_INTER_OP_THREADS=1
# Optional: defaults to STREETCLIP_API_KEY; never commit a real value.
GPUOCR_API_KEY=

# User-authored or explicitly adopted OCR place terms only; no photos or chat history are sent.
# Set false for local-only resolution. Batch evaluation always disables it.
M_PHOTO_GEOCODER_ENABLED=true
M_PHOTO_GEOCODER_PROVIDER=photon
M_PHOTO_GEOCODER_BASE_URL=https://photon.komoot.io/api
# English locality names improve exact matching against the local city catalog.
M_PHOTO_GEOCODER_LANGUAGE=en
# Optional keyed alternative to the public Photon endpoint. MapTiler keys are
# normally restricted by HTTP referrer, so mirror the frontend origin. The key
# is required and the explicit URL keeps the default Photon policy intact.
# M_PHOTO_GEOCODER_PROVIDER=maptiler
# M_PHOTO_GEOCODER_BASE_URL=https://api.maptiler.com/geocoding
# M_PHOTO_GEOCODER_API_KEY=
# M_PHOTO_GEOCODER_REFERER=http://127.0.0.1:8080/
# Per-attempt bounds; transient connect/read failures are retried up to
# MAX_ATTEMPTS before the clue is reported as unavailable.
M_PHOTO_GEOCODER_TIMEOUT_SECONDS=6
M_PHOTO_GEOCODER_CONNECT_TIMEOUT_SECONDS=1.5
M_PHOTO_GEOCODER_MAX_ATTEMPTS=3
# M_PHOTO_GEOCODER_RETRY_BACKOFF_SECONDS=0.5
# Reuse a successful TLS connection for this many idle seconds.
# M_PHOTO_GEOCODER_KEEPALIVE_SECONDS=60
M_PHOTO_GEOCODER_MIN_INTERVAL_SECONDS=1


# Optional sourced local city-alias / POI / road index. Missing file means no
# supplemental POI/road coverage; city catalog and Chinese city names still work.
# See data/place-evidence.example.json and docs/place-evidence.md; rebuild backend after adding data.
# M_PHOTO_LOCAL_PLACE_INDEX=/app/data/place-evidence.json

# Optional general web search after local/geocoder results are insufficient.
# none keeps the existing online geocoder; web search never invents city facts.
M_PHOTO_WEB_SEARCH_PROVIDER=none
# Tavily: set provider=tavily and an API key; default endpoint is shown below.
# M_PHOTO_WEB_SEARCH_API_KEY=
# M_PHOTO_WEB_SEARCH_BASE_URL=https://api.tavily.com/search
# SearXNG: set provider=searxng and your instance search URL with JSON enabled.
# M_PHOTO_WEB_SEARCH_BASE_URL=https://your-search-instance.example/search
M_PHOTO_WEB_SEARCH_TIMEOUT_SECONDS=4
M_PHOTO_WEB_SEARCH_CONNECT_TIMEOUT_SECONDS=1.5
