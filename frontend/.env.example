# Copy to frontend/.env.local for local development (never commit real keys).
# Vite only exposes VITE_* variables, and they are inlined into the built
# bundle: treat every value here as PUBLIC. If VITE_MAPTILER_API_KEY is set, it
# is a public client-side key and MUST be restricted (allowed origins /
# referrers) in the MapTiler console. No server secrets belong in these
# variables.

# Optional full MapLibre style JSON URL. Takes precedence over the key below.
# MapTiler hybrid adds satellite imagery with labels; replace <public-key>:
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/hybrid/style.json?key=<public-key>
VITE_MAP_STYLE_URL=

# Optional MapTiler public key; resolves to
# https://api.maptiler.com/maps/streets-v4/style.json?key=<key>
VITE_MAPTILER_API_KEY=

# If both are empty, the app uses the bundled Esri World Imagery raster style
# (public/esri-world-imagery-style.json). No API key is required for that
# default. Production builds do not need to configure either override.
