# Copy to frontend/.env.local for local development (never commit real keys).
# Vite only exposes VITE_* variables, and they are inlined into the built
# bundle: treat every value here as PUBLIC. A MapTiler key is a public
# client-side key and MUST be restricted (allowed origins / referrers) in the
# MapTiler console. No server secrets belong in these variables.

# Option A: full MapLibre style JSON URL (takes precedence over the key below).
VITE_MAP_STYLE_URL=

# Option B: MapTiler public key; resolves to
# https://api.maptiler.com/maps/streets-v4/style.json?key=<key>
VITE_MAPTILER_API_KEY=

# If both are empty the app falls back to the official MapLibre demo tiles
# (https://demotiles.maplibre.org/style.json), which are demo-only and carry
# no production SLA. Production builds must set one of the two options above.
